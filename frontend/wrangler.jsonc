// The app UI as a static-assets Cloudflare Worker (no Worker script: Cloudflare
// serves dist/ directly). Deployed by Cloudflare Workers Builds on push to main, or `npm run deploy`; see
// docs/DEPLOY.md. Security headers and caching live in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-customer-support-system",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/chat, /console) get index.html.
    "not_found_handling": "single-page-application"
  },
  // Publish at https://agentic-customer-support-system.<your-account-subdomain>.workers.dev.
  "workers_dev": true,
  "preview_urls": false,
  // Workers Builds uses this only for PR previews. Production settings above
  // remain unchanged. Preview builds need a staging API origin (docs/DEPLOY.md).
  "previews": {}
}
